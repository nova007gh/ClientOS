# ── ClientOS Web — Production Environment ──
# Copy this file to .env.local and fill in your values
# Set these in your Vercel dashboard under Project Settings → Environment Variables

# API URL — your deployed NestJS API URL (Belmo, Render, Railway, etc.)
NEXT_PUBLIC_API_URL=https://your-api-url/api

# App URL — your deployed frontend URL
NEXT_PUBLIC_APP_URL=https://your-app.vercel.app

# Google Maps API Key — enable Maps JavaScript API and Places API in Google Cloud Console
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your-google-maps-api-key
