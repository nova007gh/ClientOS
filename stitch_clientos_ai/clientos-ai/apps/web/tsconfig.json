{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "preserve",
    "incremental": true,
    "noEmit": true,
    "types": [
      "node",
      "google.maps"
    ],
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@clientos/ui": [
        "../../packages/ui/src/index.ts"
      ],
      "@clientos/types": [
        "../../packages/types/src/index.ts"
      ],
      "@clientos/validation": [
        "../../packages/validation/src/index.ts"
      ],
      "@clientos/database": [
        "../../packages/database/src/index.ts"
      ]
    },
    "allowJs": true,
    "plugins": [
      {
        "name": "next"
      }
    ]
  },
  "include": [
    "next-env.d.ts",
    "src/**/*",
    ".next/types/**/*.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
