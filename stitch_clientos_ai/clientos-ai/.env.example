# ──────────────────────────────────────────────
# ClientOS AI — Environment Variables
# ──────────────────────────────────────────────

# Core
DATABASE_URL=postgresql://clientos:clientos@localhost:5432/clientos?schema=public
REDIS_URL=redis://localhost:6379
APP_URL=http://localhost:3000

# Security
JWT_SECRET=change-me-in-production-min-32-chars
ENCRYPTION_KEY=change-me-32-byte-hex-key-here

# OAuth — Google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# OAuth — Microsoft
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# AI / LLM
AI_OPENAI_API_KEY=
AI_ANTHROPIC_API_KEY=
AI_DEFAULT_PROVIDER=openai
AI_DEFAULT_MODEL=gpt-4o-mini
AI_SERVICE_URL=http://localhost:8002

# Business Data Provider
BUSINESS_DATA_PROVIDER=
BUSINESS_DATA_API_KEY=

# Object Storage (S3-compatible)
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=clientos
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin

# Payments — Paystack
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=

# Payments — Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_APP_URL=http://localhost:3000

# API
API_PORT=3001
CORS_ORIGIN=http://localhost:3000
