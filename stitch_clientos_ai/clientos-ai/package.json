{
  "name": "clientos-ai",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "db:generate": "pnpm --filter @clientos/database prisma:generate",
    "db:migrate": "pnpm --filter @clientos/database prisma:migrate",
    "db:seed": "pnpm --filter @clientos/database prisma:seed",
    "db:studio": "pnpm --filter @clientos/database prisma:studio"
  },
  "devDependencies": {
    "next": "^14.2.7",
    "turbo": "^2.1.0",
    "typescript": "^5.5.4",
    "prettier": "^3.3.3"
  },
  "packageManager": "pnpm@9.7.1",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  }
}
